{
  "name": "ai-pdlc-learning-stage-4-requirements",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "setup": "npm run doctor && npm run check",
    "doctor": "tsx scripts/doctor.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "skills:update": "tsx scripts/sync-mtp-skills.ts update",
    "skills:check": "tsx scripts/sync-mtp-skills.ts check",
    "typecheck": "tsc --noEmit",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "privacy:scan": "tsx scripts/privacy-scan.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run skills:check && npm run openspec:validate && npm run privacy:scan",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
